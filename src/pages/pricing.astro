---
import Base from '../layouts/Base.astro';
---
<Base title="Pricing" description="Tallyhop pricing: Starter free, Solo $12 per month, Studio $29 per month.">
  <h1>Pricing</h1>
  <table>
    <tr><th>Plan</th><th>Price</th><th>Includes</th></tr>
    <tr><td>Starter</td><td>$0</td><td>3 clients, unlimited invoices</td></tr>
    <tr><td>Solo</td><td>$12 / month</td><td>Unlimited clients, reminders, tax set-aside</td></tr>
    <tr><td>Studio</td><td>$29 / month</td><td>Up to 5 team members, retainers, multi-currency</td></tr>
  </table>
  <p>Tallyhop takes no cut of your payments. Card fees are passed through at cost.</p>
</Base>
