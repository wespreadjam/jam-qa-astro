---
import Base from '../layouts/Base.astro';
---
<Base title="Features" description="Time tracking, invoicing, reminders, tax set-aside and multi-currency.">
  <h1>Features</h1>
  <h2>Time tracking</h2><p>A menu-bar timer that tags hours to a client and project.</p>
  <h2>Invoices</h2><p>Branded PDF invoices with card, ACH and SEPA payment links.</p>
  <h2>Reminders</h2><p>Three escalating reminders you can edit, sent on your schedule.</p>
  <h2>Tax set-aside</h2><p>Moves a percentage of each payment into a separate tax pot.</p>
</Base>
